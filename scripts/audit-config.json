{
  "typography": {
    "fontFamily": "Inter, sans-serif",
    "sizes": {
      "h1": "2rem",
      "h2": "1.75rem",
      "h3": "1.5rem",
      "body": "0.875rem",
      "caption": "0.75rem"
    },
    "lineHeight": {
      "h1": "2.5rem",
      "h2": "2.25rem",
      "h3": "2rem",
      "body": "1.25rem"
    }
  },
  "spacing": {
    "grid": "4px",
    "padding": {
      "sm": "8px",
      "md": "12px",
      "lg": "16px"
    },
    "margin": {
      "sm": "8px",
      "md": "12px",
      "lg": "16px"
    }
  },
  "contrast": {
    "minRatio": 4.5,
    "foregroundColors": ["#FFFFFF", "#F5F5F5", "#FFC700"],
    "backgroundColors": ["#262628", "#363638", "#3A3A3C"],
    "vars": {
      "--background-primary": "#262628",
      "--background-secondary": "#262628",
      "--surface-primary": "#363638",
      "--surface-secondary": "#3A3A3C",
      "--surface-tertiary": "#48484A",
      "--text-primary": "#FFFFFF",
      "--text-secondary": "#C7C7CC",
      "--text-tertiary": "#8E8E93",
      "--text-muted": "#8E8E93",
      "--accent-primary": "#FFD60A",
      "--accent-gold": "#FFD60A",
      "--accent-red": "#FF453A",
      "--accent-green": "#30D158",
      "--accent-blue": "#0A84FF",
      "--border-primary": "rgba(255,255,255,0.08)",
      "--border-secondary": "rgba(255,255,255,0.04)",
      "--bg-primary": "#262628",
      "--bg-surface": "#363638",
      "--bg-surface-elevated": "#3A3A3C",
      "--bg-overlay": "rgba(0,0,0,0.65)"
    }
  },
