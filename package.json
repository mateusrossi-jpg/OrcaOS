{
  "name": "aferix",
  "private": true,
  "version": "0.1.0-rc.1",
  "type": "module",
  "description": "Aferix - ERP financeiro local-first para propostas, custos, lucro real e relatórios.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "visual:qa": "node scripts/visual-qa.mjs",
    "rc:check": "npm run typecheck && npm test && npm run build && npm run visual:qa",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build:apk:debug": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:build:aab": "npm run build && cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.43.0",
    "@vitejs/plugin-react": "latest",
    "dexie": "^4.4.2",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.1",
    "eslint": "^10.4.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "latest"
  },
  "keywords": [
    "aferix",
    "orcamentos",
    "erp-financeiro",
    "local-first",
    "gestao-financeira",
    "lucro-real",
    "relatorios"
  ],
  "author": "Aferix",
  "license": "UNLICENSED"
}
