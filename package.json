{
  "name": "aferix",
  "private": true,
  "version": "0.1.0-rc.1",
  "type": "module",
  "description": "Aferix - ERP financeiro local-first para propostas, custos, lucro real e relatórios.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "visual:qa": "node scripts/visual-qa.mjs",
    "rc:check": "npm run typecheck && npm test && npm run build",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build:apk:debug": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:build:aab": "npm run build && cap sync android && cd android && ./gradlew bundleRelease",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.43.0",
    "@vitejs/plugin-react": "latest",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.16.0",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "^3.6.0",
    "typescript": "latest",
    "vite": "latest",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.5.0",
    "css": "^3.0.0",
    "eslint": "^10.4.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tinycolor2": "^1.6.0",
    "ts-morph": "^28.0.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "latest",
    "storybook": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-vitest": "^10.4.2",
